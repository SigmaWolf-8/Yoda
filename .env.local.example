# ═══════════════════════════════════════════════════════════════════════
# YODA — Local development / desktop environment
# ═══════════════════════════════════════════════════════════════════════
#
#   cp .env.local.example .env.local
#   # then replace both CHANGE_ME secrets (see below)
#
# Values here match the PostgreSQL service in docker-compose.yml, so
# `docker compose --profile db up -d` and this file line up with no edits.
#
# Read by:
#   * scripts/local-setup.sh      — sanity-checks the values
#   * the Tauri desktop shell     — passed straight into the yoda-api sidecar
#   * `cargo run --bin yoda-api`  — if you export it: `set -a; . ./.env.local; set +a`
#
# .env.local is gitignored. Never commit real secrets.
# ═══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgres://yoda:yoda_secret@localhost:5432/yoda

# ── Server ────────────────────────────────────────────────────────────
# Loopback only: the desktop build has no reason to expose the API to the
# local network. Change BIND_PORT and you must rebuild the frontend with a
# matching VITE_API_BASE_URL (scripts/build-frontend.mjs reads BIND_PORT).
BIND_ADDR=127.0.0.1
BIND_PORT=3000

# ── Authentication ────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
# They must differ from one another.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_different_from_jwt_secret
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────
# The Vite dev server origin. Ignored by the packaged desktop app, which
# loads from tauri://localhost.
CORS_ORIGIN=http://localhost:5173

# ── Paths ─────────────────────────────────────────────────────────────
# Repo-relative; the packaged app overrides these with its bundled copies.
AGENTS_COMPILED_PATH=./agents/compiled
MODEL_LINEAGES_PATH=./model_lineages.json

# ── Logging ───────────────────────────────────────────────────────────
# Module-specific filters work too: "yoda_api=debug,yoda_orchestrator=info"
RUST_LOG=info
