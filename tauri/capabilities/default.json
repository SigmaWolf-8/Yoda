{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window permissions plus the scoped right to execute the bundled yoda-api sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/yoda-api",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
